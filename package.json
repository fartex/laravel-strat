{
    "name": "laravel-strat",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "directories": {
        "doc": "docs",
        "test": "tests"
    },
    "scripts": {
        "build": "vite build",
        "dev": "npm run link:assets && vite build --watch",
        "link:assets": "rm -rf vendor/orchestra/testbench-core/laravel/public/vendor/strat && mkdir -p vendor/orchestra/testbench-core/laravel/public/vendor && ln -sfn \"$(pwd)/dist\" vendor/orchestra/testbench-core/laravel/public/vendor/strat",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write \"resources/**/*.{ts,vue,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\"",
        "lint": "eslint resources --fix",
        "lint:check": "eslint resources"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fartex/laravel-strat.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/fartex/laravel-strat/issues"
    },
    "homepage": "https://github.com/fartex/laravel-strat#readme",
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@fortawesome/fontawesome-svg-core": "^7.3.0",
        "@fortawesome/free-brands-svg-icons": "^7.3.0",
        "@fortawesome/free-regular-svg-icons": "^7.3.0",
        "@fortawesome/free-solid-svg-icons": "^7.3.0",
        "@fortawesome/vue-fontawesome": "^3.3.1",
        "@unhead/vue": "^3.1.8",
        "axios": "^1.18.1",
        "es-toolkit": "^1.49.0",
        "tailwindcss": "^4.3.2",
        "vue": "^3.5.39",
        "vue-i18n": "^11.4.6",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "@types/qs": "^6.15.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.1.4",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.7"
    }
}
